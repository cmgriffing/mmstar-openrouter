{
  "name": "@mmstar/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "demo": "bun run src/index.tsx --demo",
    "e2e": "bun run scripts/e2e-workflow.ts",
    "smoke": "bun run src/index.tsx --smoke",
    "build": "bun build ./src/cli.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "test": "vitest run && bun test ./src/tui/render.bun.tsx ./src/tui/pty.bun.ts",
    "validate": "bun run src/cli.ts validate",
    "benchmark": "bun run src/index.tsx benchmark",
    "resume": "bun run src/index.tsx resume",
    "retry-failed": "bun run src/index.tsx retry-failed",
    "restart": "bun run src/index.tsx restart",
    "export": "bun run src/cli.ts export"
  },
  "dependencies": {
    "@mmstar/benchmark": "workspace:*",
    "@mmstar/config": "workspace:*",
    "@mmstar/results": "workspace:*",
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
