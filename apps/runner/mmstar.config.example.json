{
  "$schema": "./mmstar.config.schema.json",
  "version": 1,
  "dataset": {
    "path": "MMStar.tsv"
  },
  "execution": {
    "maxConcurrentGroups": 4,
    "maxRetries": 3,
    "requestTimeoutMs": 120000,
    "maxRequestsPerMinute": null,
    "resultsRoot": "results"
  },
  "models": {
    "example-image-model": {
      "openRouterId": "example-vendor/example-image-model",
      "reasoningModes": ["default"],
      "rateLimitGroup": "example-group"
    }
  },
  "sets": {
    "example": {
      "models": ["example-image-model"]
    }
  }
}
