    "nemotron-3-nano-omni-30b-a3b-reasoning": {
      "openRouterId": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
      "reasoningModes": ["default"],
      "rateLimitGroup": "testing-group4"
    }
  },
  "sets": {
    "testing": {
      "models": [
        "space-bunny-alpha",
        "qwen3.8-27b",
        "gemma-4-26b-a4b-it",
        "gemma-4-31b-it",
