{
  "$schema": "./mmstar.config.schema.json",
  "version": 1,
  "dataset": {
    "path": "MMStar.tsv"
  },
  "execution": {
    "maxConcurrentGroups": 4,
    "maxRetries": 3,
    "requestTimeoutMs": 300000,
    "maxRequestsPerMinute": null,
    "resultsRoot": "results"
  },
  "models": {
    "deepseek-v4.1-flash": {
      "openRouterId": "deepseek/deepseek-v4.1-flash",
      "reasoningModes": "all",
      "rateLimitGroup": "deepseek"
    },
    "qwen3.7-flash": {
      "openRouterId": "qwen/qwen3.7-flash",
      "reasoningModes": "all",
      "rateLimitGroup": "alibaba"
    },
    "glm-5.3-flash": {
      "openRouterId": "z-ai/glm-5.3-flash",
      "reasoningModes": "all",
      "rateLimitGroup": "glm"
    },
    "ternary-bonsai-2-27b": {
      "openRouterId": "prism-ml/ternary-bonsai-2-27b",
      "reasoningModes": "all",
      "rateLimitGroup": "ternary"
    },
    "mimo-v2.6-flash": {
      "openRouterId": "xiaomi/mimo-v2.6-flash",
      "reasoningModes": "all",
      "rateLimitGroup": "mimo"
    }
  },
  "sets": {
    "testing": {
      "models": [
        "deepseek-v4.1-flash",
        "qwen3.7-flash",
        "glm-5.3-flash",
        "ternary-bonsai-2-27b",
        "mimo-v2.6-flash"
      ]
    }
  }
}
