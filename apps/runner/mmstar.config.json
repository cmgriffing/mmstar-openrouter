    "gemma-4-26b-a4b-it": {
      "openRouterId": "google/gemma-4-26b-a4b-it:free",
      "reasoningModes": ["default"],
      "rateLimitGroup": "testing-group3"
    },
    "gemma-4-31b-it": {
      "openRouterId": "google/gemma-4-31b-it:free",
      "reasoningModes": ["default"],
      "rateLimitGroup": "testing-group3"
