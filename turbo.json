{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["OPENROUTER_API_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "validate": {
      "cache": false
    }
  }
}
