{
  "name": "mmstar-openrouter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=10.24.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "biome format --write .",
    "schema": "pnpm --filter @mmstar/config schema",
    "validate": "turbo run validate",
    "benchmark": "pnpm --filter @mmstar/runner benchmark",
    "resume": "pnpm --filter @mmstar/runner resume",
    "retry-failed": "pnpm --filter @mmstar/runner retry-failed",
    "restart": "pnpm --filter @mmstar/runner restart",
    "export": "cd apps/runner && bun run src/cli.ts export --out ../../publication"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "varlock": "^1.20.0"
  }
}
